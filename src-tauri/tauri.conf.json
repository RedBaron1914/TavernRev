{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TavernRev",
  "version": "1.5.0",
  "identifier": "com.stoya.tavernrev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TavernRev",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**/*"]
      },
      "csp": "default-src 'self' tauri: localhost; img-src 'self' data: asset: https://asset.localhost https: http:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/stoyaka/TavernRev/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRTJEQjAxRTVDNEQ4MzYKUldRMjJNVGxBZHZpRW4zMk8vRFEvdEl3NUdZUFhoZE9TR1phZVNoTTVlQU0wQWFpOWZXazdOYk0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
